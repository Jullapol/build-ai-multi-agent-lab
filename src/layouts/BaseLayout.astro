---
import { loadProfile } from '../lib/profile';

interface Props {
  title?: string;
  description?: string;
}
const profile = loadProfile();
// D9: default meta must stay neutral — never mention how the site was built.
const { title = profile.name, description = `เว็บแนะนำตัวของ ${profile.name}` } = Astro.props;
const path = Astro.url.pathname;
// D3: two-item menu — never link to a page that does not exist.
const navItems = [
  { href: '/', label: 'หน้าแรก', current: path === '/' },
  { href: '/about', label: 'เกี่ยวกับผม', current: path.startsWith('/about') },
];
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      /*
       * D10 warm palette (cream / brick / light brown). Whole token set swapped
       * together. WCAG AA checked against --bg #fbf5ec:
       * --text 15.0:1 · --muted 8.1:1 · --accent 5.7:1 · white on --accent 6.1:1.
       * --accent-soft / --border are decorative only (never used for text).
       */
      :root {
        --bg: #fbf5ec;
        --card: #fffaf3;
        --text: #2b1d14;
        --muted: #5c4636;
        --accent: #a8401f;
        --accent-soft: #c9a882;
        --border: #e6d5c0;
        --on-accent: #ffffff;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "Segoe UI", "Noto Sans Thai", system-ui, sans-serif;
        background: radial-gradient(circle at top, #fffdf8, var(--bg) 55%);
        color: var(--text);
        min-height: 100vh;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      a:focus-visible, button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
      main { width: min(920px, 92vw); margin: 0 auto; padding: 1.5rem 0 4rem; }
      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        margin: 1rem 0;
      }
      nav {
        display: flex; gap: 0.5rem 1.25rem; flex-wrap: wrap;
        width: min(920px, 92vw); margin: 0 auto; padding: 1rem 0;
        border-bottom: 1px solid var(--border);
      }
      nav a { color: var(--muted); font-weight: 600; }
      nav a[aria-current="page"] { color: var(--text); border-bottom: 2px solid var(--accent); }
      h1, h2, h3 { line-height: 1.25; color: var(--text); }
      p, li { color: var(--muted); line-height: 1.7; }
      input, textarea, button {
        font: inherit; border-radius: 10px; border: 1px solid var(--accent-soft);
        background: #ffffff; color: var(--text); padding: 0.7rem 0.9rem; width: 100%;
      }
      button { background: var(--accent); color: var(--on-accent); border-color: var(--accent); font-weight: 700; cursor: pointer; width: auto; }
      label { display: block; margin: 0.75rem 0 0.35rem; color: var(--text); font-weight: 600; }
      .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
      .button-link {
        display: inline-block; padding: 0.6rem 1.1rem; border-radius: 999px;
        background: var(--accent); color: var(--on-accent); font-weight: 700;
      }
      .button-link.secondary { background: transparent; color: var(--accent); border: 2px solid var(--accent); }
      .button-link:hover { text-decoration: none; filter: brightness(0.95); }
    </style>
  </head>
  <body>
    <nav aria-label="หลัก">
      {navItems.map((item) => (
        <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
