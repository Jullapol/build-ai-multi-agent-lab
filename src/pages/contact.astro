---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact">
  <section class="card">
    <h1 lang="en">Contact</h1>
    <p>ฟอร์มนี้โพสต์ไปที่ <code>POST /api/contact</code></p>
    <form id="contact-form">
      <label lang="en" for="name">Name</label>
      <input id="name" name="name" required maxlength="80" />
      <label lang="en" for="email">Email</label>
      <input id="email" name="email" type="email" required maxlength="120" />
      <label lang="en" for="message">Message</label>
      <textarea id="message" name="message" rows="5" required maxlength="2000"></textarea>
      <p style="margin-top:1rem"><button lang="en" type="submit">Send</button></p>
      <p id="status" lang="en" role="status" aria-live="polite"></p>
    </form>
  </section>
</BaseLayout>
<script>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('status');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const payload = Object.fromEntries(fd.entries());
    status.textContent = 'Sending…';
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      status.textContent = res.ok ? 'Sent. Thank you!' : `Error: ${data.error || res.status}`;
      if (res.ok) form.reset();
    } catch (err) {
      status.textContent = 'Network error';
    }
  });
</script>
