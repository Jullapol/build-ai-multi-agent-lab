---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile } from '../lib/profile';
const profile = loadProfile();
// D4: Hero = name + Builder + headline + tagline + one link. Nothing else on the first screen.
---
<BaseLayout title={profile.name} description={profile.headline}>
  <section class="hero" aria-labelledby="hero-name">
    <h1 id="hero-name">{profile.name}</h1>
    <p class="role">Builder</p>
    <p class="headline" data-testid="hero-headline">{profile.headline}</p>
    {profile.tagline && <p class="tagline" data-testid="hero-tagline">{profile.tagline}</p>}
    <p class="cta"><a class="button-link" href="/about" data-testid="hero-link">รู้จักผมมากขึ้น →</a></p>
  </section>
</BaseLayout>

<style>
  .hero { padding: 1.5rem 0 1rem; max-width: 40rem; }
  h1 { font-size: clamp(2.25rem, 9vw, 3.5rem); margin: 0; }
  .role {
    margin: 0.25rem 0 1rem; color: var(--accent); font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.95rem;
  }
  .headline { font-size: clamp(1.25rem, 5vw, 1.75rem); color: var(--text); font-weight: 600; line-height: 1.45; margin: 0 0 0.75rem; }
  .tagline { font-size: 1.05rem; margin: 0 0 1.25rem; }
  .cta { margin: 1.25rem 0 0; }
</style>
