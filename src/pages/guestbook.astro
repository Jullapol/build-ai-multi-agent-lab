---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Guestbook">
  <section class="card">
    <h1>Guestbook</h1>
    <p>ฝากข้อความไว้ได้ทางฟอร์มนี้ — อ่าน/เขียนผ่าน <code>/api/guestbook</code></p>
    <form id="gb-form">
      <label for="name">Name</label>
      <input id="name" name="name" required maxlength="80" />
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="3" required maxlength="500"></textarea>
      <!-- Honeypot (D-05): คนไม่เห็น · bot กรอก → API ตอบ 201 ปลอม ไม่บันทึก -->
      <label class="hp-field" for="website">Website</label>
      <input class="hp-field" id="website" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <p style="margin-top:1rem"><button type="submit">Sign</button></p>
    </form>
    <div id="entries" class="card" style="margin-top:1.25rem" aria-live="polite">Loading…</div>
  </section>
</BaseLayout>
<style is:global>
  /* ซ่อนนอกจอ ไม่ใช้ display:none — บาง bot/autofill ข้าม field ที่ display:none */
  .hp-field { position: absolute; left: -9999px; }
</style>
<script>
  const entries = document.getElementById('entries');
  const form = document.getElementById('gb-form');
  // ค่าจาก DB เป็น input ผู้ใช้ — ต้อง escape ก่อนใส่ innerHTML (กัน stored XSS)
  function escapeHtml(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }
  async function load() {
    const res = await fetch('/api/guestbook');
    const data = await res.json();
    if (!res.ok) {
      entries.textContent = data.error || `HTTP ${res.status}`;
      return;
    }
    entries.innerHTML = (data.entries || [])
      .map((e) => `<p><strong>${escapeHtml(e.name)}</strong>: ${escapeHtml(e.message)}<br/><small>${escapeHtml(e.created_at)}</small></p>`)
      .join('') || '<p>No entries yet.</p>';
  }
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = Object.fromEntries(new FormData(form).entries());
    const res = await fetch('/api/guestbook', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (!res.ok) {
      const data = await res.json().catch(() => ({}));
      // textContent = ไม่ตีความเป็น HTML · ไม่ reset เพื่อให้ผู้ใช้แก้แล้วส่งใหม่ได้
      entries.textContent = `ส่งไม่สำเร็จ: ${data.error || `HTTP ${res.status}`}`;
      return;
    }
    form.reset();
    await load();
  });
  load();
</script>

